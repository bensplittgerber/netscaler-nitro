{
  "nsip": "https://192.0.2.10",

  "steps": [
    { "comment": "Hardened frontend: cipher group (forward secrecy + AEAD only) on ssl_prof_frontend_secure, strict HTTP profile on the Gateway",
      "note": "Run after 04-gateway.json. Check the result with an external TLS test (e.g. SSL Labs) - clients without TLS 1.2 ECDHE-GCM/ChaCha20 can no longer connect." },

    { "comment": "Cipher group: TLS 1.3 + TLS 1.2 ECDHE with AES-GCM / ChaCha20 (RSA and ECDSA server certificates)",
      "note": "A new SSL profile has the DEFAULT cipher group bound. Binding this group adds it; remove DEFAULT once by hand afterwards (MANUAL, NITRO object files cannot unbind): unbind ssl profile ssl_prof_frontend_secure -cipherName DEFAULT; save ns config" },
    { "resource": "sslcipher", "data": { "ciphergroupname": "cg_frontend_secure" } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.3-AES256-GCM-SHA384", "cipherpriority": 1 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.3-CHACHA20-POLY1305-SHA256", "cipherpriority": 2 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.3-AES128-GCM-SHA256", "cipherpriority": 3 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.2-ECDHE-ECDSA-AES256-GCM-SHA384", "cipherpriority": 4 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.2-ECDHE-ECDSA-CHACHA20-POLY1305", "cipherpriority": 5 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.2-ECDHE-ECDSA-AES128-GCM-SHA256", "cipherpriority": 6 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.2-ECDHE-RSA-AES256-GCM-SHA384", "cipherpriority": 7 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.2-ECDHE-RSA-CHACHA20-POLY1305", "cipherpriority": 8 } },
    { "resource": "sslcipher_sslciphersuite_binding", "data": { "ciphergroupname": "cg_frontend_secure", "ciphername": "TLS1.2-ECDHE-RSA-AES128-GCM-SHA256", "cipherpriority": 9 } },
    { "resource": "sslprofile_sslcipher_binding", "data": { "name": "ssl_prof_frontend_secure", "ciphername": "cg_frontend_secure", "cipherpriority": 1 } },

    { "comment": "HTTP profile: drop invalid / non-RFC requests, WebSocket on (HTML5 Workspace, smart card over WebSocket), HTTP/2 off" },
    { "resource": "nshttpprofile", "data": {
        "name": "nshttp_strict_websocket",
        "dropinvalreqs": "ENABLED", "markhttp09inval": "ENABLED", "markconnreqinval": "ENABLED",
        "marktracereqinval": "ENABLED", "markrfc7230noncompliantinval": "ENABLED",
        "markhttpheaderextrawserror": "ENABLED", "allowonlywordcharactersandhyphen": "ENABLED",
        "hostheadervalidation": "ENABLED", "dropextracrlf": "ENABLED",
        "websocket": "ENABLED", "http2": "DISABLED" } },
    { "resource": "vpnvserver", "method": "PUT",
      "data": { "name": "gw_example_com", "httpprofilename": "nshttp_strict_websocket" },
      "note": "MANUAL in the journal. Before an undo of this file: set vpn vserver gw_example_com -httpProfileName nshttp_default_profile (a profile in use cannot be removed), and bind DEFAULT to the SSL profile again if you removed it." }
  ]
}
