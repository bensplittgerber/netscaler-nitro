{
  "nsip": "https://<NSIP-or-SNIP-with-mgmt>",

  "steps": [
    { "comment": "=== HOW STEPS WORK ===",
      "note": "POST = add object | *_binding = PUT (bind) | \"action\" = POST ?action=x | \"method\": \"PUT\" = set/update an existing object | \"skip\": true = ignore step | \"note\" = free text. All steps in this template are skip:true - copy what you need into a new file and remove skip. Parameter names = NITRO names (CLI option in lower case). Full list per resource: NITRO API reference -> Configuration -> <resource>." },

    { "comment": "=== SYSTEM ===" },
    { "skip": true, "resource": "nsfeature", "action": "enable",
      "data": { "feature": ["LB", "CS", "SSL", "SSLVPN", "AAA", "REWRITE", "RESPONDER"] } },
    { "skip": true, "resource": "nsmode", "action": "enable",
      "data": { "mode": ["USNIP", "L3", "FR", "Edge"] } },

    { "comment": "=== LB: SERVERS / MONITORS ===" },
    { "skip": true, "resource": "server", "note": "IP based",
      "data": { "name": "<srv_name>", "ipaddress": "<10.0.0.1>" } },
    { "skip": true, "resource": "server", "note": "DNS based",
      "data": { "name": "<srv_name_fqdn>", "domain": "<host.example.com>" } },
    { "skip": true, "resource": "lbmonitor", "note": "HTTP / HTTPS (secure YES)",
      "data": { "monitorname": "<mon_http>", "type": "HTTP", "httprequest": "HEAD /", "respcode": ["200"],
                "secure": "NO", "interval": 5, "resptimeout": 2, "retries": 3, "downtime": 30 } },
    { "skip": true, "resource": "lbmonitor", "note": "HTTP-ECV: check response body",
      "data": { "monitorname": "<mon_ecv>", "type": "HTTP-ECV", "send": "GET /health", "recv": "OK", "secure": "YES" } },
    { "skip": true, "resource": "lbmonitor", "note": "StoreFront monitor",
      "data": { "monitorname": "<mon_storefront>", "type": "STOREFRONT", "storename": "<Store>", "secure": "YES" } },
    { "skip": true, "resource": "lbmonitor", "note": "TCP port check",
      "data": { "monitorname": "<mon_tcp>", "type": "TCP" } },

    { "comment": "=== LB: SERVICES (single backend) ===" },
    { "skip": true, "resource": "service",
      "data": { "name": "<svc_name>", "servername": "<srv_name>", "servicetype": "HTTP", "port": 80,
                "usip": "NO", "useproxyport": "YES", "cka": "NO", "tcpb": "NO", "cmp": "NO",
                "clttimeout": 180, "svrtimeout": 360 } },
    { "skip": true, "resource": "lbmonitor_service_binding",
      "data": { "monitorname": "<mon_http>", "servicename": "<svc_name>" } },
    { "skip": true, "resource": "sslservice", "method": "PUT", "note": "set ssl service (backend SSL profile)",
      "data": { "servicename": "<svc_name_ssl>", "sslprofile": "ns_default_ssl_profile_backend" } },

    { "comment": "=== LB: SERVICE GROUPS (several backends, preferred) ===" },
    { "skip": true, "resource": "servicegroup",
      "data": { "servicegroupname": "<sg_name>", "servicetype": "SSL", "usip": "NO", "useproxyport": "YES",
                "cka": "NO", "tcpb": "NO", "cmp": "NO", "clttimeout": 180, "svrtimeout": 360 } },
    { "skip": true, "resource": "servicegroup_servicegroupmember_binding",
      "data": { "servicegroupname": "<sg_name>", "servername": "<srv_name>", "port": 443, "weight": 1 } },
    { "skip": true, "resource": "servicegroup_lbmonitor_binding",
      "data": { "servicegroupname": "<sg_name>", "monitor_name": "<mon_http>" } },
    { "skip": true, "resource": "sslservicegroup", "method": "PUT",
      "data": { "servicegroupname": "<sg_name>", "sslprofile": "ns_default_ssl_profile_backend" } },

    { "comment": "=== LB: VIRTUAL SERVERS ===" },
    { "skip": true, "resource": "lbvserver", "note": "addressable SSL vserver",
      "data": { "name": "<lb_vs_name>", "servicetype": "SSL", "ipv46": "<VIP>", "port": 443,
                "lbmethod": "LEASTCONNECTION", "persistencetype": "SOURCEIP", "timeout": 180, "clttimeout": 180 } },
    { "skip": true, "resource": "lbvserver", "note": "non-addressable (behind CS) - no ipv46/port",
      "data": { "name": "<lb_vs_backend>", "servicetype": "SSL" } },
    { "skip": true, "resource": "lbvserver", "note": "HTTP -> HTTPS redirect vserver (always DOWN, redirect URL used)",
      "data": { "name": "<lb_vs_redirect>", "servicetype": "HTTP", "ipv46": "<VIP>", "port": 80,
                "redirurl": "https://<host.example.com>" } },
    { "skip": true, "resource": "lbvserver", "method": "PUT", "note": "set lb vserver (change an existing one)",
      "data": { "name": "<lb_vs_name>", "lbmethod": "ROUNDROBIN" } },
    { "skip": true, "resource": "lbvserver_service_binding",
      "data": { "name": "<lb_vs_name>", "servicename": "<svc_name>" } },
    { "skip": true, "resource": "lbvserver_servicegroup_binding",
      "data": { "name": "<lb_vs_name>", "servicegroupname": "<sg_name>" } },

    { "comment": "=== CONTENT SWITCHING ===" },
    { "skip": true, "resource": "csvserver",
      "data": { "name": "<cs_vs_name>", "servicetype": "SSL", "ipv46": "<VIP>", "port": 443, "clttimeout": 180 } },
    { "skip": true, "resource": "csaction",
      "data": { "name": "<csact_app>", "targetlbvserver": "<lb_vs_backend>" } },
    { "skip": true, "resource": "cspolicy",
      "data": { "policyname": "<cspol_app>", "rule": "HTTP.REQ.HOSTNAME.EQ(\"app.example.com\")", "action": "<csact_app>" } },
    { "skip": true, "resource": "csvserver_cspolicy_binding",
      "data": { "name": "<cs_vs_name>", "policyname": "<cspol_app>", "priority": 100 } },
    { "skip": true, "resource": "csvserver_lbvserver_binding", "note": "default target",
      "data": { "name": "<cs_vs_name>", "lbvserver": "<lb_vs_backend>" } },

    { "comment": "=== REWRITE / RESPONDER ===" },
    { "skip": true, "resource": "rewriteaction",
      "data": { "name": "<rwact_hsts>", "type": "insert_http_header", "target": "Strict-Transport-Security",
                "stringbuilderexpr": "\"max-age=15552000\"" } },
    { "skip": true, "resource": "rewritepolicy",
      "data": { "name": "<rwpol_hsts>", "rule": "true", "action": "<rwact_hsts>" } },
    { "skip": true, "resource": "lbvserver_rewritepolicy_binding",
      "data": { "name": "<lb_vs_name>", "policyname": "<rwpol_hsts>", "priority": 100,
                "gotopriorityexpression": "NEXT", "bindpoint": "RESPONSE" } },
    { "skip": true, "resource": "responderaction",
      "data": { "name": "<rspact_redirect>", "type": "redirect",
                "target": "\"https://\" + HTTP.REQ.HOSTNAME + HTTP.REQ.URL", "responsestatuscode": 301 } },
    { "skip": true, "resource": "responderpolicy",
      "data": { "name": "<rsppol_redirect>", "rule": "HTTP.REQ.IS_VALID", "action": "<rspact_redirect>" } },
    { "skip": true, "resource": "lbvserver_responderpolicy_binding",
      "data": { "name": "<lb_vs_redirect>", "policyname": "<rsppol_redirect>", "priority": 100,
                "gotopriorityexpression": "END" } },

    { "comment": "=== SSL: PROFILES / VSERVER SETTINGS / CERT BINDINGS ===",
      "note": "certs themselves are deployed with Deploy-NsCertificates.ps1" },
    { "skip": true, "resource": "sslprofile", "note": "needs 'set ssl parameter -defaultProfile ENABLED'",
      "data": { "name": "<ssl_prof_frontend>", "sessreuse": "ENABLED", "sesstimeout": 120,
                "tls1": "DISABLED", "tls11": "DISABLED", "tls12": "ENABLED", "tls13": "ENABLED",
                "denysslreneg": "NONSECURE", "hsts": "ENABLED", "maxage": 15552000,
                "includesubdomains": "YES", "preload": "YES" } },
    { "skip": true, "resource": "sslvserver", "method": "PUT", "note": "set ssl vserver (any vserver type)",
      "data": { "vservername": "<vs_name>", "sslprofile": "<ssl_prof_frontend>" } },
    { "skip": true, "resource": "sslvserver_sslcertkey_binding", "note": "server certificate",
      "data": { "vservername": "<vs_name>", "certkeyname": "<certkey>" } },
    { "skip": true, "resource": "sslvserver_sslcertkey_binding", "note": "additional SNI certificate (SNI enabled in profile)",
      "data": { "vservername": "<vs_name>", "certkeyname": "<certkey2>", "snicert": true } },
    { "skip": true, "resource": "sslvserver_sslcertkey_binding", "note": "CA cert for client cert auth",
      "data": { "vservername": "<vs_name>", "certkeyname": "<ca_certkey>", "ca": true, "crlcheck": "Optional" } },

    { "comment": "=== AAA: AUTHENTICATION ACTIONS ===" },
    { "skip": true, "resource": "authenticationldapaction",
      "data": { "name": "<ldap_act>", "serverip": "<dc-ip>", "serverport": 636, "sectype": "SSL",
                "ldapbase": "DC=corp,DC=example", "ldapbinddn": "<svc_user@corp.example>",
                "ldapbinddnpassword": "${env:LDAP_BIND_PW}", "ldaploginname": "sAMAccountName",
                "groupattrname": "memberOf", "subattributename": "cn", "ssonameattribute": "userPrincipalName" } },
    { "skip": true, "resource": "authenticationradiusaction",
      "data": { "name": "<radius_act>", "serverip": "<radius-ip>", "serverport": 1812,
                "radkey": "${env:RADIUS_KEY}", "authtimeout": 30 } },
    { "skip": true, "resource": "authenticationsamlaction",
      "data": { "name": "<saml_act>", "samlidpcertname": "<idp_certkey>", "samlsigningcertname": "<sp_certkey>",
                "samlredirecturl": "https://<idp>/sso", "samlissuername": "https://<gateway-fqdn>",
                "samluserfield": "NameID", "logouturl": "https://<idp>/logout",
                "relaystaterule": "AAA.LOGIN.RELAYSTATE.EQ(\"https://<gateway-fqdn>/\")" } },
    { "skip": true, "resource": "authenticationoauthaction",
      "data": { "name": "<oauth_act>", "authorizationendpoint": "https://<idp>/authorize",
                "tokenendpoint": "https://<idp>/token", "clientid": "<client-id>",
                "clientsecret": "${env:OAUTH_SECRET}", "certendpoint": "https://<idp>/keys" } },
    { "skip": true, "resource": "authenticationcertaction", "note": "client certificate / smartcard",
      "data": { "name": "<cert_act>", "twofactor": "OFF", "usernamefield": "SubjectAltName:PrincipalName" } },

    { "comment": "=== AAA: POLICIES / LOGIN SCHEMA / nFACTOR ===" },
    { "skip": true, "resource": "authenticationpolicy", "note": "advanced authentication policy",
      "data": { "name": "<authpol>", "rule": "true", "action": "<ldap_act>" } },
    { "skip": true, "resource": "authenticationpolicy", "note": "NO_AUTHN = only route to next factor",
      "data": { "name": "<authpol_noauthn>", "rule": "true", "action": "NO_AUTHN" } },
    { "skip": true, "resource": "authenticationloginschema",
      "data": { "name": "<lschema>", "authenticationschema": "/nsconfig/loginschema/LoginSchema/SingleAuth.xml" } },
    { "skip": true, "resource": "authenticationloginschemapolicy",
      "data": { "name": "<lschema_pol>", "rule": "true", "action": "<lschema>" } },
    { "skip": true, "resource": "authenticationpolicylabel", "note": "nFactor: next factor",
      "data": { "labelname": "<factor2_label>", "loginschema": "LSCHEMA_INT" } },
    { "skip": true, "resource": "authenticationpolicylabel_authenticationpolicy_binding",
      "data": { "labelname": "<factor2_label>", "policyname": "<authpol_radius>", "priority": 100,
                "gotopriorityexpression": "NEXT" } },

    { "comment": "=== AAA: VSERVER + AUTHENTICATION PROFILE ===" },
    { "skip": true, "resource": "authenticationvserver", "note": "non-addressable",
      "data": { "name": "<aaa_vs>", "servicetype": "SSL" } },
    { "skip": true, "resource": "authenticationvserver_authenticationloginschemapolicy_binding",
      "data": { "name": "<aaa_vs>", "policy": "<lschema_pol>", "priority": 100, "gotopriorityexpression": "END" } },
    { "skip": true, "resource": "authenticationvserver_authenticationpolicy_binding", "note": "nextfactor optional",
      "data": { "name": "<aaa_vs>", "policy": "<authpol>", "priority": 100,
                "gotopriorityexpression": "NEXT", "nextfactor": "<factor2_label>" } },
    { "skip": true, "resource": "authenticationauthnprofile",
      "data": { "name": "<authnprof>", "authnvsname": "<aaa_vs>", "authenticationhost": "<gateway-fqdn>" } },

    { "comment": "=== GATEWAY: SESSION / THEME ===" },
    { "skip": true, "resource": "vpnsessionaction", "note": "ICA proxy to StoreFront",
      "data": { "name": "<sess_act_web>", "transparentinterception": "OFF", "defaultauthorizationaction": "ALLOW",
                "sso": "ON", "ssocredential": "PRIMARY", "icaproxy": "ON", "clientlessvpnmode": "OFF",
                "wihome": "https://<storefront>/Citrix/StoreWeb", "storefronturl": "https://<storefront>" } },
    { "skip": true, "resource": "vpnsessionpolicy", "note": "web browsers",
      "data": { "name": "<sess_pol_web>", "rule": "HTTP.REQ.HEADER(\"User-Agent\").CONTAINS(\"CitrixReceiver\").NOT", "action": "<sess_act_web>" } },
    { "skip": true, "resource": "vpnportaltheme",
      "data": { "name": "<theme>", "basetheme": "RfWebUI" } },

    { "comment": "=== GATEWAY: VSERVER ===" },
    { "skip": true, "resource": "vpnvserver",
      "data": { "name": "<gw_vs>", "servicetype": "SSL", "ipv46": "<VIP>", "port": 443,
                "icaonly": "ON", "dtls": "ON", "downstateflush": "DISABLED", "listenpolicy": "NONE",
                "authnprofile": "<authnprof>" } },
    { "skip": true, "resource": "vpnvserver_staserver_binding",
      "data": { "name": "<gw_vs>", "staserver": "https://<ddc-or-cloudconnector>" } },
    { "skip": true, "resource": "vpnvserver_vpnsessionpolicy_binding",
      "data": { "name": "<gw_vs>", "policy": "<sess_pol_web>", "priority": 100,
                "gotopriorityexpression": "NEXT", "bindpoint": "REQUEST" } },
    { "skip": true, "resource": "vpnvserver_vpnportaltheme_binding",
      "data": { "name": "<gw_vs>", "portaltheme": "<theme>" } },
    { "skip": true, "resource": "vpnvserver_cachepolicy_binding", "note": "built-in cache policies, repeat per policy",
      "data": { "name": "<gw_vs>", "policy": "_cacheTCVPNStaticObjects", "priority": 10,
                "gotopriorityexpression": "END", "bindpoint": "REQUEST" } }
  ]
}
